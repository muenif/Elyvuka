# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/elyvuka

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (order confirmations - customer + admin)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ELYVUKA <no-reply@elyvuka.com>"
ADMIN_EMAIL=admin@elyvuka.com

# Initial admin account (used only by the seed:admin script)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@elyvuka.com
SEED_ADMIN_PASSWORD=ChangeMe123!
